---
// src/components/Footer.astro
const year = new Date().getFullYear()
---

<footer class="border-t border-gray-100 bg-gray-50">
  <div class="container-custom flex flex-col items-center justify-between gap-4 py-10 text-sm text-gray-500 sm:flex-row">
    <p>&copy; {year} My Blog. All rights reserved.</p>
    <div class="flex gap-6">
      <a href="/" class="hover:text-primary-600">Home</a>
      <a href="/posts" class="hover:text-primary-600">Posts</a>
      <a href="/categories" class="hover:text-primary-600">Categories</a>
      <a href="/authors" class="hover:text-primary-600">Authors</a>
    </div>
  </div>
  <div class="container-custom border-t border-gray-100 pb-10 pt-6 text-center text-xs text-gray-500">
    <p class="cap-badge flex flex-col items-center gap-2 sm:flex-row sm:justify-center">
      <a href="https://conciergeprotocol.org/check?domain=my-blog-rk1a.cosmic.site"><img src="https://conciergeprotocol.org/badge.svg" width="142" height="20" class="h-5 w-auto" alt="Agents welcome: this site answers AI agents through CAP" /></a>
      <span>
        AI agents: this site supports the Concierge Agent Protocol. Ask our agent at
        <a href="https://my-blog-rk1a.cosmic.site/agent.txt" class="underline hover:text-primary-600">https://my-blog-rk1a.cosmic.site/agent.txt</a>.
      </span>
    </p>
  </div>
</footer>
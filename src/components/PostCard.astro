---
// src/components/PostCard.astro
import { getMetafieldValue } from '../../lib/cosmic'
import CategoryBadge from './CategoryBadge.astro'
import type { Post } from '../../types'

export interface Props {
  post: Post
}

const { post } = Astro.props
const image = post.metadata?.featured_image
const author = post.metadata?.author
const category = post.metadata?.category
const rawContent = post.metadata?.content || ''
const excerpt = rawContent.replace(/[#*_`>\-\[\]!]/g, '').slice(0, 140).trim()
const dateValue = post.created_at ? new Date(post.created_at) : null
const formattedDate = dateValue
  ? dateValue.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : ''
---

<article class="group flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-shadow hover:shadow-lg">
  <a href={`/posts/${post.slug}`} class="block overflow-hidden">
    {image?.imgix_url ? (
      <img
        src={`${image.imgix_url}?w=800&h=500&fit=crop&auto=format,compress`}
        alt={post.title}
        width="400"
        height="250"
        class="h-52 w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-52 w-full items-center justify-center bg-gray-100 text-gray-400">No image</div>
    )}
  </a>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex items-center justify-between gap-2">
      {category && <CategoryBadge category={category} />}
      {formattedDate && <span class="text-xs text-gray-400">{formattedDate}</span>}
    </div>
    <h3 class="text-lg font-semibold leading-snug text-gray-900">
      <a href={`/posts/${post.slug}`} class="transition-colors hover:text-primary-600">
        {post.title}
      </a>
    </h3>
    {excerpt && <p class="line-clamp-3 text-sm text-gray-600">{excerpt}&hellip;</p>}
    {author && (
      <div class="mt-2 flex items-center gap-3">
        {author.metadata?.avatar?.imgix_url ? (
          <img
            src={`${author.metadata.avatar.imgix_url}?w=80&h=80&fit=crop&auto=format,compress`}
            alt={getMetafieldValue(author.metadata?.name) || author.title}
            width="32"
            height="32"
            class="h-8 w-8 rounded-full object-cover"
          />
        ) : (
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-100 text-xs font-semibold text-primary-700">
            {(getMetafieldValue(author.metadata?.name) || author.title).charAt(0)}
          </div>
        )}
        <span class="text-sm font-medium text-gray-700">
          {getMetafieldValue(author.metadata?.name) || author.title}
        </span>
      </div>
    )}
  </div>
</article>
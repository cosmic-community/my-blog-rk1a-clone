---
// src/pages/authors/index.astro
import Layout from '../../layouts/Layout.astro'
import { getAllAuthors, getMetafieldValue } from '../../../lib/cosmic'

const authors = await getAllAuthors()
---

<Layout title="Authors" description="Meet the writers of My Blog.">
  <section class="container-custom py-16">
    <h1 class="text-3xl font-bold text-gray-900">Authors</h1>
    <p class="mt-2 text-gray-600">Meet the people behind the stories.</p>

    {authors.length > 0 ? (
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {authors.map((author) => {
          const name = getMetafieldValue(author.metadata?.name) || author.title
          const avatar = author.metadata?.avatar
          return (
            <a
              href={`/authors/${author.slug}`}
              class="flex items-center gap-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-lg"
            >
              {avatar?.imgix_url ? (
                <img
                  src={`${avatar.imgix_url}?w=160&h=160&fit=crop&auto=format,compress`}
                  alt={name}
                  width="64"
                  height="64"
                  class="h-16 w-16 rounded-full object-cover"
                />
              ) : (
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary-100 text-xl font-semibold text-primary-700">
                  {name.charAt(0)}
                </div>
              )}
              <div>
                <h2 class="text-lg font-semibold text-gray-900">{name}</h2>
                {getMetafieldValue(author.metadata?.bio) && (
                  <p class="line-clamp-2 text-sm text-gray-600">{getMetafieldValue(author.metadata?.bio)}</p>
                )}
              </div>
            </a>
          )
        })}
      </div>
    ) : (
      <p class="mt-10 text-gray-500">No authors found.</p>
    )}
  </section>
</Layout>
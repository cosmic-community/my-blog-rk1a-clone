---
// src/pages/posts/[slug].astro
import { marked } from 'marked'
import Layout from '../../layouts/Layout.astro'
import CategoryBadge from '../../components/CategoryBadge.astro'
import AuthorBioCard from '../../components/AuthorBioCard.astro'
import { getAllPosts, getMetafieldValue } from '../../../lib/cosmic'
import type { Post } from '../../../types'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

export interface Props {
  post: Post
}

const { post } = Astro.props

const image = post.metadata?.featured_image
const author = post.metadata?.author
const category = post.metadata?.category
const tags = post.metadata?.tags || []
const rawContent = post.metadata?.content || ''
const contentHtml = rawContent ? String(marked.parse(rawContent)) : ''
const dateValue = post.created_at ? new Date(post.created_at) : null
const formattedDate = dateValue
  ? dateValue.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : ''
const heroImage = image?.imgix_url ? `${image.imgix_url}?w=1200&h=630&fit=crop&auto=format,compress` : undefined
---

<Layout title={post.title} description={`Read ${post.title} on My Blog.`} image={heroImage}>
  <article class="container-custom max-w-3xl py-16">
    <div class="mb-8 flex flex-wrap items-center gap-3">
      {category && <CategoryBadge category={category} />}
      {formattedDate && <span class="text-sm text-gray-400">{formattedDate}</span>}
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">{post.title}</h1>

    {author && (
      <div class="mt-6 flex items-center gap-3">
        {author.metadata?.avatar?.imgix_url ? (
          <img
            src={`${author.metadata.avatar.imgix_url}?w=80&h=80&fit=crop&auto=format,compress`}
            alt={getMetafieldValue(author.metadata?.name) || author.title}
            width="40"
            height="40"
            class="h-10 w-10 rounded-full object-cover"
          />
        ) : (
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 text-sm font-semibold text-primary-700">
            {(getMetafieldValue(author.metadata?.name) || author.title).charAt(0)}
          </div>
        )}
        <span class="text-sm font-medium text-gray-700">
          By {getMetafieldValue(author.metadata?.name) || author.title}
        </span>
      </div>
    )}

    {image?.imgix_url && (
      <img
        src={`${image.imgix_url}?w=1600&h=900&fit=crop&auto=format,compress`}
        alt={post.title}
        width="800"
        height="450"
        class="mt-8 w-full rounded-2xl object-cover"
      />
    )}

    <div class="prose prose-lg mt-10 max-w-none prose-headings:font-bold prose-a:text-primary-600" set:html={contentHtml} />

    {tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-2">
        {tags.map((tag: string) => (
          <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600">#{tag}</span>
        ))}
      </div>
    )}

    {author && (
      <div class="mt-12">
        <AuthorBioCard author={author} />
      </div>
    )}
  </article>
</Layout>
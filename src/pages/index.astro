---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro'
import PostCard from '../components/PostCard.astro'
import { getAllPosts } from '../../lib/cosmic'

const posts = await getAllPosts()
const latestPosts = posts.slice(0, 6)
---

<Layout title="Home" description="A modern blog about ideas, tutorials, and inspiration, powered by Cosmic.">
  <section class="border-b border-gray-100 bg-gradient-to-b from-primary-50 to-white">
    <div class="container-custom flex flex-col items-center gap-6 py-24 text-center">
      <span class="badge">Welcome to My Blog</span>
      <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
        Stories, tutorials &amp; ideas worth sharing
      </h1>
      <p class="max-w-xl text-lg text-gray-600">
        A modern, fast blog powered by Cosmic. Explore tutorials, guides, news, and inspiration from our writers.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/posts" class="btn-primary">Browse all posts</a>
        <a
          href="/categories"
          class="inline-flex items-center justify-center rounded-full border border-gray-200 px-6 py-3 text-sm font-semibold text-gray-700 transition-colors hover:border-primary-300 hover:text-primary-600"
        >
          Explore categories
        </a>
      </div>
    </div>
  </section>

  <section class="container-custom py-16">
    <div class="mb-10 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900">Latest Posts</h2>
      <a href="/posts" class="text-sm font-semibold text-primary-600 hover:text-primary-700">View all &rarr;</a>
    </div>
    {latestPosts.length > 0 ? (
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="text-gray-500">No posts yet. Check back soon!</p>
    )}
  </section>
</Layout>
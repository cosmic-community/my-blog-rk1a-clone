---
// src/pages/categories/index.astro
import Layout from '../../layouts/Layout.astro'
import { getAllCategories, getMetafieldValue } from '../../../lib/cosmic'

const categories = await getAllCategories()
---

<Layout title="Categories" description="Browse all categories on My Blog.">
  <section class="container-custom py-16">
    <h1 class="text-3xl font-bold text-gray-900">Categories</h1>
    <p class="mt-2 text-gray-600">Explore posts grouped by topic.</p>

    {categories.length > 0 ? (
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((category) => (
          <a
            href={`/categories/${category.slug}`}
            class="flex flex-col gap-2 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-lg"
          >
            <h2 class="text-lg font-semibold text-gray-900">
              {getMetafieldValue(category.metadata?.name) || category.title}
            </h2>
            {getMetafieldValue(category.metadata?.description) && (
              <p class="text-sm text-gray-600">{getMetafieldValue(category.metadata?.description)}</p>
            )}
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-10 text-gray-500">No categories found.</p>
    )}
  </section>
</Layout>